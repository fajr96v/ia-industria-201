          "assignments": [
            {
              "id": "49282a89-ae08-43a4-864c-beb60684743b",
              "name": "registro",
              "value": "={{ { hora: $now.toISO(), peticion: $('Petición').item.json.peticion, herramienta: $json.herramienta, dato: $json.herramienta === 'ninguna' ? null : $('Dato para el modelo').first().json, respuesta: $json.respuesta, comprobacion: $json.comprobacion } }}",
              "type": "object"
            },
            {
              "id": "22f47afc-170b-4eda-8cd6-03ca91876ebe",
              "name": "=linea",
              "value": "={{ JSON.stringify({ hora: $now.toISO(), peticion: $('Petición').item.json.peticion, herramienta: $json.herramienta, dato: $json.herramienta === 'ninguna' ? null : $('Dato para el modelo').first().json, respuesta: $json.respuesta, comprobacion: $json.comprobacion }) + \"\\n\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
